        <mxCell id="note" value="Never stops or rewinds while powered. Reset sets it to zero." style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#202124;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="400" width="560" height="70" as="geometry"/></mxCell>
