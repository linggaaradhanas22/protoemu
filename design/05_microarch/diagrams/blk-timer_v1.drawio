        <mxCell id="counter" value="24-bit&lt;br&gt;cycle register" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontColor=#202124;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="180" height="240" as="geometry"/></mxCell>
