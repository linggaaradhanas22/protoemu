        <mxCell id="m13" value="Registered READY" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.75;entryX=0.5;entryY=0.75;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="rp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note14" value="03   Resolve coincident controls on the output edge" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="850" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="Safe on STOP or fault cleanup" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.8558;entryX=0.5;entryY=0.8558;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="pads">
          <mxGeometry relative="1" as="geometry" />
