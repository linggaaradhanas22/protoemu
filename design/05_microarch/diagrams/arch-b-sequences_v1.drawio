        </mxCell>
        <mxCell id="m1" value="Context, deadline, mask, values and enables" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1899;entryX=0.5;entryY=0.1899;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="drive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Pre-edge cycle" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.2532;entryX=0.5;entryY=0.2532;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="timer" target="drive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="Check mask, ownership, same-deadline overlap and the future half-range before reporting full." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="270" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="Ready: enqueue in one slot; reject: fault; neither: retry" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.3924;entryX=0.5;entryY=0.3924;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="drive" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note5" value="02   Fire on the deadline edge, regardless of core activity" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="380" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="Pre-edge cycle equals a stored deadline" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5316;entryX=0.5;entryY=0.5316;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="timer" target="drive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note7" value="Merge disjoint due masks and retire every due slot whole. Reuse a retiring slot for a future event." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="490" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="Merged mask, values and enables on that edge" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6709;entryX=0.5;entryY=0.6709;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="drive" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note9" value="03   Fault and flush (alternative to continuing)" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="600" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note10" value="Due updates still retire on fault edge F." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="660" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="Flush on F+1 clears remaining entries and suppresses due updates" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.8861;entryX=0.5;entryY=0.8861;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="drive">
