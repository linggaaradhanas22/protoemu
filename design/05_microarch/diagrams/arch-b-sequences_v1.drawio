            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <mxCell id="title" value="BLK-CAPTURE | Context-owned input capture" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="4" width="545" height="30" />
        </mxCell>
        <UserObject id="back" label="Back to chip sequence" link="data:page/id,seq-chip">
          <mxCell style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=12;fontStyle=4;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="595" y="5" width="145" height="25" />
