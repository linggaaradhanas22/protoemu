          <mxGeometry x="840" y="40" width="100" height="790" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="01   Admit or block a request" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
