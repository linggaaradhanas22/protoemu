          <mxGeometry x="840" y="40" width="100" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="peer" value="Protocol peer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#ffffff;strokeColor=#202124;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="1040" y="40" width="100" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="01   Sample external inputs continuously" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="110" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Raw host CS, SCK and MOSI" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1442;entryX=0.5;entryY=0.1442;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="rp" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Raw protocol pin levels" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1923;entryX=0.5;entryY=0.1923;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="peer" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="Pass both groups through two flop stages. Forward the second stage, not the asynchronous value." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="270" width="1100" height="30" as="geometry" />
        </mxCell>
