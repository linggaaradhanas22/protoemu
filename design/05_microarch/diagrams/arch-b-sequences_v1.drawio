        <mxCell id="m7" value="Due update: mask, values and output enables" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4519;entryX=0.5;entryY=0.4519;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="drive" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note8" value="Keep unmasked pads unchanged. On open drain, high or disabled means release; never drive high." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="540" width="1100" height="30" as="geometry" />
