          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="Registered MISO bit" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7019;entryX=0.5;entryY=0.7019;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="rp">
          <mxGeometry relative="1" as="geometry" />
