  <diagram id="seq-capture" name="BLK-CAPTURE | Context-owned input capture">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="990" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="notes" value="Phase captions and notes" parent="0" />
        <mxCell id="pads" value="BLK-PADS" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="890" as="geometry" />
        </mxCell>
        <mxCell id="timer" value="BLK-TIMER" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="100" height="890" as="geometry" />
        </mxCell>
        <mxCell id="capture" value="BLK-CAPTURE" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="100" height="890" as="geometry" />
        </mxCell>
        <mxCell id="core" value="BLK-CORE" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="100" height="890" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="01   Arm the issuing context's empty slot" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="110" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Owner, pin, mode and any target or timeout" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1685;entryX=0.5;entryY=0.1685;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="capture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Accept empty slot; reject occupied slot" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.2247;entryX=0.5;entryY=0.2247;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="capture" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="02   Observe before the decision edge. An edge arm ignores the arm edge itself." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="270" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="Second-stage pin_sample" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3483;entryX=0.5;entryY=0.3483;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="capture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="Same pre-edge cycle" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4045;entryX=0.5;entryY=0.4045;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="timer" target="capture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note6" value="A sample uses deadline equality. A guarded level wait observes once its guard opens." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="430" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note7" value="A timed guard sets expiry at target + Rt × 64. A matching level wins on the expiry edge." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="490" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note8" value="03   Hold result until the owner consumes it" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="550" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="Result-ready from the next cycle; no same-edge bypass" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.6629;entryX=0.5;entryY=0.6629;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="capture" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="Consume owning slot" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.7191;entryX=0.5;entryY=0.7191;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="capture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="Sampled bit and original observation time" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7753;entryX=0.5;entryY=0.7753;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="capture" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="Or expired status for a timed wait" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.8315;entryX=0.5;entryY=0.8315;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="capture" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note13" value="Consume frees the slot. Flush clears both slots and suppresses observations on that edge." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="810" width="700" height="30" as="geometry" />
        </mxCell>
        <UserObject id="open-pads" label="BLK-PADS" link="data:page/id,seq-pads">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="pads">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <UserObject id="open-timer" label="BLK-TIMER" link="data:page/id,seq-timer">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="timer">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <UserObject id="open-core" label="BLK-CORE" link="data:page/id,seq-core">
