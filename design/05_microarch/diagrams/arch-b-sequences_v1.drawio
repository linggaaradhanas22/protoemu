          <mxGeometry x="840" y="40" width="100" height="1700" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="01   Load: each command is a separate SPI request with a separate reply frame" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="110" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="BEGIN / DATA / COMMIT frame bits" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0882;entryX=0.5;entryY=0.0882;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="rp" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Synchronized CS, SCK and MOSI" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1176;entryX=0.5;entryY=0.1176;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="DATA: stream tentative words while halted" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.1471;entryX=0.5;entryY=0.1471;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="program">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="At CS close: check length and CRC. A bad load leaves the image invalid." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="320" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="COMMIT: publish valid image; do not start" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.2118;entryX=0.5;entryY=0.2118;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="program">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="Assert READY for the pending reply" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.2412;entryX=0.5;entryY=0.2412;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="Registered READY" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.2706;entryX=0.5;entryY=0.2706;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="rp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="Reply bits" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3;entryX=0.5;entryY=0.3;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="Reply on MISO" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3294;entryX=0.5;entryY=0.3294;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="rp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note10" value="02   Run: START needs a committed image and HALTED state; preloaded ingress stays" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="630" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="START frame bits" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3941;entryX=0.5;entryY=0.3941;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="rp" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="Synchronized host inputs" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4235;entryX=0.5;entryY=0.4235;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m13" value="Entry PCs, enables and ownership masks" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4529;entryX=0.5;entryY=0.4529;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m14" value="Start enabled contexts together" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.4824;entryX=0.5;entryY=0.4824;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="Ingress word on host_get" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5118;entryX=0.5;entryY=0.5118;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m16" value="Egress word on host_put" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5412;entryX=0.5;entryY=0.5412;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note17" value="FIFOs use pre-edge counts: an enqueue into an empty FIFO cannot satisfy a same-edge read." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="990" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note18" value="03   Read results and stop" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="1050" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m19" value="READN frame bits" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6412;entryX=0.5;entryY=0.6412;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="rp" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m20" value="Synchronized host inputs" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6706;entryX=0.5;entryY=0.6706;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m21" value="Assert READY" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.7;entryX=0.5;entryY=0.7;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m22" value="Registered READY" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.7294;entryX=0.5;entryY=0.7294;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="rp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m23" value="READN reply bits" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7588;entryX=0.5;entryY=0.7588;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m24" value="Up to four words on MISO" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7882;entryX=0.5;entryY=0.7882;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="rp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note25" value="Pop READN words only on exact reply close. An interrupted reply keeps the same words." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="1410" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m26" value="STOP frame bits" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8529;entryX=0.5;entryY=0.8529;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="rp" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m27" value="Synchronized host inputs" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.8824;entryX=0.5;entryY=0.8824;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m28" value="Safe on the edge after validated STOP close" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.9118;entryX=0.5;entryY=0.9118;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="pads">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note29" value="That edge also flushes timed work and FIFOs and invalidates the image. Acknowledge after it." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="1620" width="900" height="30" as="geometry" />
        </mxCell>
        <UserObject id="open-pads" label="BLK-PADS" link="data:page/id,seq-pads">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="pads">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <UserObject id="open-program" label="BLK-PROGRAM" link="data:page/id,seq-program">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="program">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <UserObject id="open-core" label="BLK-CORE" link="data:page/id,seq-core">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="core">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <mxCell id="title" value="BLK-HOST | Loader and run control" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="4" width="550" height="30" />
        </mxCell>
        <UserObject id="back" label="Back to chip sequence" link="data:page/id,seq-chip">
          <mxCell style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=12;fontStyle=4;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="795" y="5" width="145" height="25" />
          </mxCell>
        </UserObject>
        <mxCell id="key" value="Read top to bottom. Solid: data. Dashed: control / status. Blue: ASIC blocks at 60 MHz." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1748" width="900" height="26" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="seq-program" name="BLK-PROGRAM | Shared program store">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="580" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="notes" value="Phase captions and notes" parent="0" />
        <mxCell id="host" value="BLK-HOST" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="780" as="geometry" />
        </mxCell>
        <mxCell id="program" value="BLK-PROGRAM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="100" height="780" as="geometry" />
        </mxCell>
        <mxCell id="core" value="BLK-CORE" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="100" height="780" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="01   Load while halted (fetch disabled)" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="110" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="BEGIN: image invalid" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.1923;entryX=0.5;entryY=0.1923;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="program">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="DATA: index and 24-bit word" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.2564;entryX=0.5;entryY=0.2564;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="program">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="Write in place. Fetch cannot see tentative words, even after bad DATA." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="270" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="COMMIT: image valid; fetch still disabled" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.3974;entryX=0.5;entryY=0.3974;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="program">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note5" value="02   Registered read after START" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="380" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="Running: enable fetch" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.5385;entryX=0.5;entryY=0.5385;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="program">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="Fetch PC on edge n" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.6026;entryX=0.5;entryY=0.6026;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="program">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note8" value="Check PC against the committed word count. No writes during run." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="540" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="In range: registered word for execute on n+1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7436;entryX=0.5;entryY=0.7436;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="program" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="Otherwise: registered bounds fault (no word)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.8077;entryX=0.5;entryY=0.8077;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="program" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note11" value="Reset clears response validity and hides old words; it does not clear the array." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="700" width="500" height="30" as="geometry" />
        </mxCell>
        <UserObject id="open-host" label="BLK-HOST" link="data:page/id,seq-host">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="host">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <UserObject id="open-core" label="BLK-CORE" link="data:page/id,seq-core">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="core">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <mxCell id="title" value="BLK-PROGRAM | Shared program store" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="4" width="345" height="30" />
        </mxCell>
        <UserObject id="back" label="Back to chip sequence" link="data:page/id,seq-chip">
          <mxCell style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=12;fontStyle=4;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="395" y="5" width="145" height="25" />
          </mxCell>
        </UserObject>
        <mxCell id="key" value="Read top to bottom. Solid: data. Dashed: control / status. Blue: ASIC blocks at 60 MHz." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=12;" vertex="1" parent="1">
