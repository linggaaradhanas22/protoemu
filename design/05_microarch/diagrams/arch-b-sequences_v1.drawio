          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="Synchronized pin_sample" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3462;entryX=0.5;entryY=0.3462;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="pads" target="capture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note6" value="02   Register outputs" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
