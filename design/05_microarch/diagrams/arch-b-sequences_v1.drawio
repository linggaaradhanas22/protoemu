        </mxCell>
        <mxCell id="timer" value="BLK-TIMER" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="100" height="1170" as="geometry" />
        </mxCell>
        <mxCell id="drive" value="BLK-DRIVE" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="840" y="40" width="100" height="1170" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="01   Fetch, then execute" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="110" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Start enabled contexts at committed PCs" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.1282;entryX=0.5;entryY=0.1282;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="host" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="At a free issue boundary, choose a runnable context by round robin and retain its fetch tag." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="220" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="Selected context's fetch PC" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.2222;entryX=0.5;entryY=0.2222;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="program">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="Registered instruction word" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.265;entryX=0.5;entryY=0.265;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="program" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="Pre-edge cycle for execute" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3077;entryX=0.5;entryY=0.3077;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="timer" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note6" value="02   Example: one timed output instruction" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="430" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="Absolute deadline and masked update" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4017;entryX=0.5;entryY=0.4017;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="drive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="Ready, blocked or reject" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.4444;entryX=0.5;entryY=0.4444;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="drive" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note9" value="Ready: retire once. Update the shift register only on admission." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="590" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note10" value="Blocked: save decoded request and operands. The other context can issue while this one waits." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="650" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="Retry same deadline and data without refetch" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.5897;entryX=0.5;entryY=0.5897;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="drive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="Ready, still blocked or reject" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.6325;entryX=0.5;entryY=0.6325;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="drive" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note13" value="Capture and payload stalls use the same saved-operation approach." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="810" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note14" value="03   End paths (alternatives)" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="870" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note15" value="HALT ends just that context; admitted pad updates still retire." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="930" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m16" value="DONE when all enabled contexts halt and drive is empty" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.8291;entryX=0.5;entryY=0.8291;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note17" value="Fault F: do not retire the bad instruction. Accept no other issue on F. Due I/O still acts on F." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="1040" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m18" value="FAULTED and fault record; F+1 is the global safe edge" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.9231;entryX=0.5;entryY=0.9231;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="core" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject id="open-host" label="BLK-HOST" link="data:page/id,seq-host">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="host">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <UserObject id="open-program" label="BLK-PROGRAM" link="data:page/id,seq-program">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="program">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <UserObject id="open-timer" label="BLK-TIMER" link="data:page/id,seq-timer">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="timer">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <UserObject id="open-drive" label="BLK-DRIVE" link="data:page/id,seq-drive">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="drive">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <mxCell id="title" value="BLK-CORE | Shared issue core" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="4" width="550" height="30" />
        </mxCell>
        <UserObject id="back" label="Back to chip sequence" link="data:page/id,seq-chip">
          <mxCell style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=12;fontStyle=4;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="795" y="5" width="145" height="25" />
          </mxCell>
        </UserObject>
        <mxCell id="key" value="Read top to bottom. Solid: data. Dashed: control / status. Blue: ASIC blocks at 60 MHz." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#202124;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1218" width="900" height="26" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="seq-timer" name="BLK-TIMER | Shared cycle timebase">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="notes" value="Phase captions and notes" parent="0" />
        <mxCell id="clk" value="Board clock" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#ffffff;strokeColor=#202124;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="750" as="geometry" />
        </mxCell>
        <mxCell id="timer" value="BLK-TIMER" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="100" height="750" as="geometry" />
        </mxCell>
        <mxCell id="core" value="BLK-CORE" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="100" height="750" as="geometry" />
        </mxCell>
        <mxCell id="drive" value="BLK-DRIVE" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="100" height="750" as="geometry" />
        </mxCell>
        <mxCell id="capture" value="BLK-CAPTURE" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="840" y="40" width="100" height="750" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="01   Reset sets the counter to zero" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="110" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="60 MHz rising edge" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;exitX=0.5;exitY=0.2;entryX=0.5;entryY=0.2;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="clk" target="timer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="02   On each active edge: consumers read the same pre-edge C in parallel" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="220" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="C for issue and deadline calculation" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.3467;entryX=0.5;entryY=0.3467;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="timer" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="C for admission and due comparison" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.4133;entryX=0.5;entryY=0.4133;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="timer" target="drive">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="C for sample comparison and observation timestamp" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.48;entryX=0.5;entryY=0.48;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontColor=#202124;strokeColor=#293548;fontSize=12;spacingBottom=2;" edge="1" parent="1" source="timer" target="capture">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note6" value="On that edge the counter also registers (C + 1) mod 2^24. START, HALT and fault do not rewind it." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="430" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note7" value="03   Consumers use C in two ways" style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#e7eff9;strokeColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="notes">
          <mxGeometry x="40" y="490" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note8" value="New drive or timed sample: accept only a positive delta less than 2^23. Accepted work fires on equality." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="550" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note9" value="Guard: classify once. A future target waits for equality; zero or a past-half delta opens the guard." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="610" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note10" value="The consumer keeps the guard open. The timer sends only a number, not a trigger or a clock." style="rounded=0;html=1;align=left;spacingLeft=10;fontFamily=Helvetica;fontColor=#202124;fillColor=#f5f5f5;strokeColor=none;fontSize=12;" vertex="1" parent="notes">
          <mxGeometry x="40" y="670" width="900" height="30" as="geometry" />
        </mxCell>
        <UserObject id="open-core" label="BLK-CORE" link="data:page/id,seq-core">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="core">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
        </UserObject>
        <UserObject id="open-drive" label="BLK-DRIVE" link="data:page/id,seq-drive">
          <mxCell style="rounded=0;html=1;align=center;fillColor=#dae8fc;strokeColor=none;fontFamily=Helvetica;fontColor=#193c66;fontStyle=5;fontSize=12;" vertex="1" parent="drive">
            <mxGeometry as="geometry" x="2" y="2" width="96" height="36" />
          </mxCell>
